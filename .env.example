# Copy to .env.local and fill in. Never commit .env.local.

REACTBITS_LICENSE_KEY=

HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
UNSPLASH_ACCESS_KEY=

RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=
RESEND_FROM_EMAIL=

NEXT_PUBLIC_GA_MEASUREMENT_ID=
