# ── Secrets ──────────────────────────────────────────────────
.env
.env.local
.env*.local
.env.production

# ── Internal — never publish ─────────────────────────────────
# This repo is PUBLIC. These files carry the fee, refund exposure,
# timeline strategy, upsell pricing and critiques of the client's own
# material. Ignored by directory AND by name, so moving one to the
# repo root does not quietly expose it.
/internal/
PROJECT_LOG.md
PLAN.md
UPSELL.md
AUDIT.md
BEFORE-AFTER.*
BEFORE_AFTER.*
phase1-*.html
phase2-*.html
*-directions.html
*-palette.html
agreement.*
*.pdf

# Baseline capture + the client's original media. Large, and the
# "before" data is unrecoverable once DNS cuts over — keep it local.
/baseline/
/assets/original/

# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js ──────────────────────────────────────────────────
/.next/
/out/
/build
next-env.d.ts

# ── Vercel ───────────────────────────────────────────────────
.vercel

# ── Testing ──────────────────────────────────────────────────
/coverage
/playwright-report/
/test-results/
/.playwright/

# ── TypeScript ───────────────────────────────────────────────
*.tsbuildinfo

# ── Logs ─────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── OS / editor ──────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# ── Misc ─────────────────────────────────────────────────────
.cache/
tmp/

# Local Netlify folder
.netlify

# Remotion render artefacts (the encoded output is committed under public/atmosphere)
video/out/
video/node_modules/
video/public/

# Generated by `next build` / `next dev` (Next 16 agentRules). Regenerated
# on every build, so tracking them just produces churn. Set `agentRules: false`
# in next.config.ts to stop them being written at all.
/AGENTS.md
/CLAUDE.md
